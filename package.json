  "scripts": {
    "start": "react-scripts start",
    "start:local": "env-cmd -f .env.development.local react-scripts start",
    "start:dev": "env-cmd -f .env.development react-scripts start",
    "start:uat": "env-cmd -f .env.uat react-scripts start",
    "build": "react-scripts build",
    "build:dev": "env-cmd -f .env.development react-scripts build",
    "build:uat": "env-cmd -f .env.uat react-scripts build",
    "build:prod": "env-cmd -f .env.production react-scripts build",
    "test": "react-scripts test",
    "test:fast": "node --no-deprecation node_modules/react-scripts/scripts/test.js --watchAll=false --cacheDirectory=.tmp/jest-cache",
    "test:trace-deprecation": "node --trace-deprecation node_modules/react-scripts/scripts/test.js --watchAll=false --cacheDirectory=.tmp/jest-cache",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:coverage:watch": "react-scripts test --coverage",
    "test:meditation": "react-scripts test --testPathPattern=Meditation --testPathIgnorePatterns=coverage.config.js --watchAll=false",
    "test:meditation:watch": "react-scripts test --testPathPattern=Meditation --testPathIgnorePatterns=coverage.config.js",
    "test:meditation:coverage": "react-scripts test --testPathPattern=Meditation --testPathIgnorePatterns=coverage.config.js --coverage --watchAll=false",
    "test:meditation:ci": "react-scripts test --testPathPattern=Meditation --testPathIgnorePatterns=coverage.config.js --coverage --watchAll=false --ci",
    "test:meditation:all": "react-scripts test --testPathPattern=Meditation --testPathIgnorePatterns=coverage.config.js --coverage",
     "test:meditation:custom": "jest --config=jest.config.js --coverage",
    "test:meditation:custom:watch": "jest --config=jest.config.js --coverage --watch",
    "test:mealtiming": "node --max_old_space_size=4096 node_modules/react-scripts/scripts/test.js --watchAll=false --runInBand --runTestsByPath src/pages/MealTiming/__tests__/api.test.ts src/pages/MealTiming/__tests__/details.test.tsx src/pages/MealTiming/__tests__/create.test.tsx src/pages/MealTiming/__tests__/columns.test.tsx src/pages/MealTiming/__tests__/schema.test.ts",
    "test:mealtiming:index": "node --max_old_space_size=4096 node_modules/react-scripts/scripts/test.js --watchAll=false --runInBand --runTestsByPath src/pages/MealTiming/__tests__/index.test.tsx",
    "test:mealtiming:watch": "node --max_old_space_size=4096 node_modules/react-scripts/scripts/test.js --runInBand --testPathPattern=MealTiming --testPathIgnorePatterns=coverage.config.js",
    "test:mealtiming:coverage": "node --max_old_space_size=4096 node_modules/react-scripts/scripts/test.js --coverage --watchAll=false --runInBand --coverageDirectory=coverage-mealtiming --coverageThreshold={} --collectCoverageFrom=src/pages/MealTiming/**/*.{ts,tsx} --collectCoverageFrom=!src/pages/MealTiming/**/*.d.ts --collectCoverageFrom=!src/pages/MealTiming/__tests__/** --collectCoverageFrom=!src/pages/MealTiming/index.tsx --runTestsByPath src/pages/MealTiming/__tests__/api.test.ts src/pages/MealTiming/__tests__/details.test.tsx src/pages/MealTiming/__tests__/create.test.tsx src/pages/MealTiming/__tests__/columns.test.tsx src/pages/MealTiming/__tests__/schema.test.ts",
    "test:plans": "node --max_old_space_size=4096 node_modules/react-scripts/scripts/test.js --watchAll=false --runInBand --cacheDirectory=node_modules/.cache/jest --testPathPattern=src/pages/Plans",
    "test:plans:details": "node --max_old_space_size=4096 node_modules/react-scripts/scripts/test.js --watchAll=false --runInBand --cacheDirectory=node_modules/.cache/jest --testPathPattern=src/pages/Plans/Details",
    "test:plans:coverage": "node --max_old_space_size=4096 node_modules/react-scripts/scripts/test.js --watchAll=false --runInBand --cacheDirectory=node_modules/.cache/jest --testPathIgnorePatterns=coverage.config.js --coverage --coverageDirectory=coverage-plans --coverageReporters=text --coverageReporters=json-summary --coverageThreshold={} --collectCoverageFrom=\"src/pages/Plans/**/*.{ts,tsx}\" --collectCoverageFrom=\"!src/pages/Plans/**/__tests__/**\" --testPathPattern=src/pages/Plans",
    "test:adminuser:coverage": "powershell -NoProfile -Command \"$covDir = '.tmp/coverage-adminuser'; $cacheDir = '.tmp/jest-cache-adminuser'; node node_modules/react-scripts/scripts/test.js --watchAll=false --runInBand --cacheDirectory=$cacheDir --coverage --coverageDirectory=$covDir --coverageReporters=text --coverageReporters=text-summary --coverageThreshold='{}' --collectCoverageFrom=src/pages/AdminUser/index.tsx --collectCoverageFrom=src/pages/AdminUser/Details.tsx --collectCoverageFrom=src/pages/AdminUser/InactiveUsers.tsx --collectCoverageFrom=src/pages/AdminUser/api.ts --collectCoverageFrom=src/pages/AdminUser/columns.tsx --collectCoverageFrom=src/pages/AdminUser/inactiveUserColumns.tsx --collectCoverageFrom=src/pages/AdminUser/Details/Vitals.tsx AdminUser; if (Test-Path $covDir) { Remove-Item -Recurse -Force $covDir }; if (Test-Path $cacheDir) { Remove-Item -Recurse -Force $cacheDir }\"",
    "test:adminuser:details": "node node_modules/react-scripts/scripts/test.js --watchAll=false --runInBand --cacheDirectory=.tmp/jest-cache-adminuser-details --runTestsByPath src/pages/AdminUser/_tests_/Details_Clients.test.tsx src/pages/AdminUser/_tests_/Details_DayDetailTabsSection.test.tsx",
    "test:adminuser:vitals": "node --max_old_space_size=4096 node_modules/react-scripts/scripts/test.js --watchAll=false --runInBand --cacheDirectory=.tmp/jest-cache-adminuser-vitals --runTestsByPath src/pages/AdminUser/_tests_/Details_Vitals.test.tsx",
    "test:adminuser:vitals:coverage": "powershell -NoProfile -Command \"$covDir = '.tmp/coverage-adminuser-vitals'; $cacheDir = '.tmp/jest-cache-adminuser-vitals'; $tmpDir = (Resolve-Path '.tmp').Path; $env:TEMP = $tmpDir; $env:TMP = $tmpDir; $env:JEST_HASTE_MAP_CACHE_DIRECTORY = $tmpDir; node --max_old_space_size=4096 node_modules/react-scripts/scripts/test.js --watchAll=false --runInBand --cacheDirectory=$cacheDir --coverage --coverageDirectory=$covDir --coverageReporters=text --coverageReporters=text-summary --coverageThreshold='{}' --collectCoverageFrom=src/pages/AdminUser/Details/Vitals.tsx --runTestsByPath src/pages/AdminUser/_tests_/Details_Vitals.test.tsx; if (Test-Path $covDir) { Remove-Item -Recurse -Force $covDir }; if (Test-Path $cacheDir) { Remove-Item -Recurse -Force $cacheDir }\"",
    "test:adminuser:details:coverage": "powershell -NoProfile -Command \"$covDir = '.tmp/coverage-adminuser-details'; $cacheDir = '.tmp/jest-cache-adminuser-details'; node --max_old_space_size=4096 node_modules/react-scripts/scripts/test.js --watchAll=false --runInBand --cacheDirectory=$cacheDir --coverage --coverageDirectory=$covDir --coverageReporters=text --coverageReporters=text-summary --coverageThreshold='{}' --collectCoverageFrom=src/pages/AdminUser/Details/AdditionalInfo.tsx --collectCoverageFrom=src/pages/AdminUser/Details/BodyComposition.tsx --collectCoverageFrom=src/pages/AdminUser/Details/BodyMeasurements.tsx --collectCoverageFrom=src/pages/AdminUser/Details/Clients.tsx --collectCoverageFrom=src/pages/AdminUser/Details/DayDetailTabsSection.tsx AdminUser; if (Test-Path $covDir) { Remove-Item -Recurse -Force $covDir }; if (Test-Path $cacheDir) { Remove-Item -Recurse -Force $cacheDir }\"",
    "test:yoga": "react-scripts test --testPathPattern=Yoga/__tests__",
    "test:yoga:coverage": "react-scripts test --coverage --testPathPattern=Yoga/__tests__",
    "lint": "eslint \"./src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"./src/**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "eject": "react-scripts eject",
    "postinstall": "husky install"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
     "transformIgnorePatterns": [
    "node_modules/(?!(axios|react-datepicker)/)"
  ],
  "moduleNameMapper": {
    "^\\.\\./Details/Recipes$": "<rootDir>/src/pages/AdminUser/Details/Recipe.tsx/Recipes.tsx",
    "^\\.\\./Details/Recipe/Recipes$": "<rootDir>/src/pages/AdminUser/Details/Recipe.tsx/Recipes.tsx",
    "^\\.\\./Details/Recipe/recipes\\.api$": "<rootDir>/src/pages/AdminUser/Details/Recipe.tsx/recipes.api.ts",
    "^\\.\\./Details/Recipe/userRecipeColumns$": "<rootDir>/src/pages/AdminUser/Details/Recipe.tsx/userRecipeColumns.tsx",
    "\\.(css|less|scss|sass)$": "identity-obj-proxy"
  },
  "collectCoverageFrom": [
    "src/pages/Meditation/**/*.{ts,tsx}",
    "!src/pages/Meditation/**/*.d.ts",
    "!src/pages/Meditation/__tests__/**",
    "!src/pages/Meditation/index.tsx"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 70,
      "functions": 70,
      "lines": 70,
      "statements": 70
    }
  },
  "coverageReporters": ["text", "html", "lcov", "json-summary"]
  },
  "prettier": {
    "semi": false,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "git add"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/crypto-js": "^4.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/html2canvas": "^1.0.0",
    "@types/lodash": "^4.14.197",
    "@types/node-sass": "^4.11.3",
    "@types/react-datepicker": "^4.15.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.11",
    "identity-obj-proxy": "^3.0.0",
    "postcss": "^8.4.44",
    "prettier": "^3.0.3",
    "react-scripts": "^5.0.1",
    "tailwindcss": "^3.3.4",
    "typescript": "^4.9.5"
  }
}
